[Unit]
Description=Lab Dashboard Docker auto-update (git pull + build + deploy)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=angel1
Group=docker
WorkingDirectory=/opt/lab-dashboard
ExecStart=/opt/lab-dashboard/system/update-docker.sh
# update-docker.sh already tees its output to logs/update-docker.log; systemd
# captures the same stream in the journal. No StandardOutput=append here, or
# every line would be written to the log file twice.

[Install]
WantedBy=multi-user.target
