[Unit]
Description=Lab Dashboard Docker auto-update (git pull + build + deploy)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=angel1
Group=docker
WorkingDirectory=/opt/lab-dashboard
ExecStart=/opt/lab-dashboard/system/update-docker.sh
StandardOutput=append:/opt/lab-dashboard/logs/update-docker.log
StandardError=append:/opt/lab-dashboard/logs/update-docker.log

[Install]
WantedBy=multi-user.target
