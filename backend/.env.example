# Copiar a .env y ajustar si hace falta. No versionar el .env real.
SSH_KEY_PATH=/home/USUARIO/.ssh/id_ed25519
POLL_INTERVAL=3
# El push por WebSocket va atado al ciclo de poll; esto sólo acota el silencio
# máximo entre mensajes (keep-alive). Debe quedar por debajo de los 10s que el
# frontend usa para dar la conexión por muerta.
WS_HEARTBEAT_INTERVAL=5
SSH_TIMEOUT=5
SSH_COMMAND_TIMEOUT=8
# Techo para una tanda completa de comandos (viajan en un solo canal SSH).
SSH_BATCH_TIMEOUT=25
SERVERS_FILE=./servers.json
LOG_FILE=../logs/events.log
NETWORK_REPORT_TOKEN=
# Timeout (s) del ping ICMP para confirmar dispositivos Companion/ADB por ARP
# (ver device_presence.py). Requiere network_mode: host en docker-compose.yml.
DEVICE_PING_TIMEOUT=1
FRAMEWORK_TELEMETRY_TOKEN=
# X-API-Key de llm-api en Servidor 2 (/etc/llm-server/api.env allá). Sin esto
# el card de IA local muestra "no disponible" pero el resto del dashboard
# sigue funcionando igual.
AI_API_KEY=
FRAMEWORK_TELEMETRY_FILE=./data/framework_telemetry.jsonl
CLAUDE_USAGE_REPORT_TOKEN=
CLAUDE_USAGE_REPORT_FILE=./data/claude_usage_push.json
